# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# These are only needed to RUN a migration; reading this repo needs nothing.

# DigitalOcean Spaces credentials, from the API > Spaces Keys page.
SPACES_KEY=
SPACES_SECRET=

# Defaults below match the live bucket; override only for a different space.
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
SPACES_REGION=fra1
SPACES_BUCKET=supaboard-landing-content
SPACES_PUBLIC_BASE=https://supaboard-landing-content.fra1.digitaloceanspaces.com
